{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "node_modules/**",
    "out/**",
    "build/**",
    "packages/**",
    "apps/desktop/**",
    "apps/frontend/dist/**",
    "apps/frontend/node_modules/**",
    "apps/api/generated/**",
    "components/reui/code-block/**",
    "user_read_only_context/**",
    "v0_memories/**",
    ".claude/**",
    ".output/**",
    ".vercel/**",
    ".hosted-ui/**"
  ],
  "jsPlugins": [
    "./scripts/oxlint-plugin-mikka.mjs"
  ],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@/lib/server-runtime/server",
            "importNames": [
              "after"
            ],
            "message": "Use afterJob from @/lib/background, so the deferred work is traced and labelled as its own job (docs/operations/tracing.md)."
          }
        ]
      }
    ],
    "mikka/no-raw-process-env": "error",
    "mikka/no-plan-name-branching": "error",
    "mikka/no-hardcoded-model-ids": "error",
    "mikka/no-hardcoded-hosts": "error"
  }
}
